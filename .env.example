# Calls to Knowledge — secrets reference
#
# The backend loads configuration from config.toml (not from .env).
# Copy config.toml.example → config.toml and fill in real values.
# Do not commit config.toml or this file with real keys.

OPENAI_API_KEY=sk-...

# Transcription: "openai" (Whisper API) or "local" (faster-whisper)
TRANSCRIPTION_PROVIDER=openai
TRANSCRIPTION_LOCAL_MODEL=medium

# AI summary model
AI_MODEL=gpt-4o-mini

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Recording (Windows WASAPI loopback)
RECORDING_MIN_DURATION_SECONDS=15
RECORDING_AUDIO_DIR=~/calls-to-knowledge/audio

# Backend server
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
